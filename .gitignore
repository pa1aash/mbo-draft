logs/

# hyperresearch regenerable index
research/index/

# built environments (the .lock files + mac-db-patches/ ARE committed; the venvs are not).
# NB: intentionally NOT a blanket `envs/` — git cannot re-include the committed .lock
# files once their parent dir is excluded, so built env dirs are listed individually.
envs/mac-synth/
envs/mac-db/
envs/pod-synth/
envs/pod-db/
envs/pod-db-torch28/
envs/conda/
envs/miniforge/

